{
  "compilerOptions": {
    "esModuleInterop": true,
    "module": "node16",
    "moduleResolution": "node16",
    "target": "es2020",
    "rootDir": "./src",
    "outDir": "./dist",
    "noImplicitAny": false,
    "declaration": true,
    "strict": true,
    "types": ["node", "jest"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "src/**/*.test.ts", "src/__mocks__"]
}
