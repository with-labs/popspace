# Copy to .env and adjust. The same file is used by `docker compose`
# and by `yarn dev` for local development.

# --- Admin login -------------------------------------------------------
# Only signed-in admins can create rooms and room links. Guests join public
# links directly and password-protected links with the room password.
# Required: without ADMIN_PASSWORD nobody can create rooms.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# --- Audio / video -----------------------------------------------------
# Defaults point at the LiveKit dev server bundled in docker-compose.yml.
COMPOSE_PROFILES=livekit
REACT_APP_LIVEKIT_ENDPOINT=ws://localhost:7880
# The bundled server is configured with this key pair. LiveKit requires a
# secret of at least 32 characters; generate one with `openssl rand -hex 32`.
LIVEKIT_API_KEY=devkey
LIVEKIT_SECRET_KEY=devsecret-change-me-0123456789abcdef
# Public IP the bundled LiveKit server announces for media (UDP 7882, TCP 7881).
# LIVEKIT_NODE_IP=203.0.113.10

# --- URLs --------------------------------------------------------------
# Public address of the API (port 8889), used to build file URLs.
PUBLIC_URL=http://localhost:8889
# Only needed when the UI runs on a different hostname than the API:
# origins allowed to send the session cookie, comma separated.
# TRUSTED_ORIGINS=https://popspace.example.com
# Number of reverse proxies (Caddy, nginx, ...) in front of the API. Leave
# unset when clients connect to port 8889 directly. Password attempts are
# limited per client IP, so set this or every user shares the proxy's IP.
# TRUST_PROXY=1
# Behind a reverse proxy that serves everything on one origin (see
# deploy/Caddyfile.example): the UI calls /api, /hermes and /unicorn
# instead of ports 8889-8891. Build-time setting, rebuild after changing.
# REACT_APP_SERVICE_PATHS=true
# Publish the container ports on this address only, e.g. 127.0.0.1 when a
# local reverse proxy is the only client. LiveKit media ports stay public.
# BIND_ADDRESS=127.0.0.1

# --- Local development paths (yarn dev) --------------------------------
# docker compose overrides these with paths in its /data volume.
NODE_ENV=development
# relative to noodle-shared/prisma, i.e. <repo>/data/db.sqlite
DATABASE_URL=file:../../data/db.sqlite?connection_limit=1
# relative to each service's folder, i.e. <repo>/data/...
UNICORN_DATABASE_URL=../data/unicorn.sqlite
USER_FILES_DIRECTORY=../data/user-files
WALLPAPERS_DIRECTORY=../data/wallpapers
