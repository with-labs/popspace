{
  "name": "popspace-monorepo",
  "private": true,
  "workspaces": [
    "file-upload",
    "hermes",
    "noodle",
    "noodle-api",
    "noodle-shared",
    "unicorn",
    "unicorn/component",
    "pop-media/sdk",
    "pop-media/livekit"
  ],
  "resolutions": {
    "**/@babel/generator": "7.29.8",
    "**/@babel/helper-compilation-targets": "7.29.7",
    "**/@babel/helper-module-transforms": "7.29.7",
    "**/@babel/helpers": "7.29.10",
    "**/@babel/parser": "7.29.11",
    "**/@babel/runtime": "7.29.10",
    "**/@babel/traverse": "7.29.10",
    "**/browserslist": "4.29.5",
    "**/jsprim/json-schema": "0.4.0",
    "**/mocha/debug": "3.2.7",
    "**/mocha/diff": "3.5.1",
    "**/mocha/js-yaml": "3.15.2",
    "**/mocha/minimatch": "3.1.5",
    "**/next/postcss": "8.5.32",
    "**/twilio/axios": "0.34.0",
    "shell-quote": "1.12.0",
    "**/refractor/prismjs": "1.30.0",
    "**/@cypress/request/qs": "6.17.0",
    "**/core-js-compat/semver": "7.8.5",
    "shelljs": "0.8.5"
  },
  "scripts": {
    "precontainerize": "yarn build-lib && yarn build",
    "build": "concurrently npm:build:*",
    "build-lib": "yarn build-media && concurrently npm:build-lib:*",
    "build-media": "yarn workspace @withso/pop-media-sdk build && yarn workspace @withso/pop-media-livekit build",
    "build:app": "yarn workspace noodle-app build",
    "build:unicorn": "yarn workspace unicorn build",
    "build-lib:shared": "yarn workspace @withso/noodle-shared build",
    "build-lib:files": "yarn workspace @withso/file-upload build",
    "build-lib:unicorn:component": "yarn workspace @withso/unicorn build",
    "dev": "env-cmd -f .env --silent concurrently npm:dev:*",
    "dev:app": "yarn workspace noodle-app dev",
    "dev:api": "yarn workspace noodle-api dev",
    "dev:hermes": "yarn workspace hermes dev",
    "dev:unicorn": "yarn workspace unicorn dev",
    "db-init": "env-cmd -f .env --silent yarn workspace @withso/noodle-shared db:init",
    "smoke-test": "env-cmd -f .env --silent node deploy/smoke-test.js"
  },
  "devDependencies": {
    "concurrently": "^6.4.0",
    "env-cmd": "10.1.0"
  },
  "volta": {
    "node": "24.22.1",
    "yarn": "1.22.22"
  }
}
